# Jira Remote MCP OAuth2 Agent Configuration
# Copy this file to .env and fill in your actual values

# Your Jira Cloud instance domain (without https://)
# Example: your-company.atlassian.net
JIRA_DOMAIN=your-domain.atlassian.net

# Your Atlassian account email address
JIRA_EMAIL=your-email@example.com

# OAuth2 App Configuration
# Create an OAuth 2.0 app at: https://developer.atlassian.com/console/myapps/
JIRA_OAUTH_CLIENT_ID=your-oauth-client-id
JIRA_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# OAuth2 Redirect URI (must match your app configuration)
# Default: http://localhost:8080/callback
JIRA_OAUTH_REDIRECT_URI=http://localhost:8080/callback

# Optional: MCP server URL (defaults to Atlassian's production server)
# JIRA_MCP_SERVER_URL=https://mcp.atlassian.com/v1/sse

# Optional: Connection timeout in seconds (default: 30)
# JIRA_CONNECTION_TIMEOUT=30

# Optional: OAuth2 callback server port (default: 8080)
# OAUTH_CALLBACK_PORT=8080