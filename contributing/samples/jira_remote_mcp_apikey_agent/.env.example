# Jira Remote MCP API Key Agent Configuration
# Copy this file to .env and fill in your actual values

# Your Jira Cloud instance domain (without https://)
# Example: your-company.atlassian.net
JIRA_DOMAIN=your-domain.atlassian.net

# Your Atlassian account email address
JIRA_EMAIL=your-email@example.com

# Your Atlassian API token
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# Optional: MCP server URL (defaults to Atlassian's production server)
# JIRA_MCP_SERVER_URL=https://mcp.atlassian.com/v1/sse

# Optional: Connection timeout in seconds (default: 30)
# JIRA_CONNECTION_TIMEOUT=30